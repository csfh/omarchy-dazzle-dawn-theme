# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#f5f1ea"

# Main text color
theme[main_fg]="#111111"

# Title color for boxes
theme[title]="#111111"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#00c2ee"

# Selected process row uses the cyan-glass selection wash so the highlight
# reads on paper without inverting the row to ink.
theme[selected_bg]="#d4eaf0"

# Keep selected row text on the main ink so it stays readable on the wash.
theme[selected_fg]="#111111"

# Color of inactive/disabled text
theme[inactive_fg]="#958e84"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
theme[graph_text]="#111111"

# Background color of the percentage meters.
theme[meter_bg]="#ebe6de"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
theme[proc_misc]="#00c6c6"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#c550fb"
theme[mem_box]="#32c24a"
theme[net_box]="#f2477c"
theme[proc_box]="#00c2ee"

# Box divider line and small boxes line color
theme[div_line]="#958e84"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#32c24a"
theme[temp_mid]="#f5a000"
theme[temp_end]="#f2477c"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#00c6c6"
theme[cpu_mid]="#00c2ee"
theme[cpu_end]="#c550fb"

# Mem/Disk free meter
theme[free_start]="#c550fb"
theme[free_mid]="#00c2ee"
theme[free_end]="#00c6c6"

# Mem/Disk cached meter
theme[cached_start]="#00c2ee"
theme[cached_mid]="#00c6c6"
theme[cached_end]="#c550fb"

# Mem/Disk available meter
theme[available_start]="#f5a000"
theme[available_mid]="#f2477c"
theme[available_end]="#ff5f87"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#32c24a"
theme[used_mid]="#00c6c6"
theme[used_end]="#00c2ee"

# Download graph colors
theme[download_start]="#f5a000"
theme[download_mid]="#f2477c"
theme[download_end]="#ff5f87"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#32c24a"
theme[upload_mid]="#00c6c6"
theme[upload_end]="#00c2ee"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#00c6c6"
theme[process_mid]="#00c2ee"
theme[process_end]="#c550fb"
